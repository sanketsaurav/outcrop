{
	"name": "outcrop-plugin",
	"version": "0.1.3",
	"private": true,
	"description": "Obsidian plugin for Outcrop — self-hosted public note sharing",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -p . && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"eslint": "^9.0.0",
		"obsidian": "^1.7.2",
		"prettier": "^3.3.0",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.0.0",
		"vitest": "^3.0.0"
	}
}
